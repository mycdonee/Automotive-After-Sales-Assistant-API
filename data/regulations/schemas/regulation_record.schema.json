{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regulation_record.schema.json",
  "title": "RegulationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "regulation_id",
    "jurisdiction",
    "authority",
    "official_identifier",
    "aliases",
    "title",
    "citation",
    "regulatory_system",
    "regulated_object",
    "scope_summary",
    "vehicle_applicability",
    "requirement_topics",
    "reviewed_version",
    "reviewed_source_documents",
    "source_format",
    "source_content_date",
    "source_reviewed_on",
    "special_status_notes",
    "verification_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "regulation_id": {
      "type": "string",
      "pattern": "^(unece|fmvss)_[a-z0-9]+$"
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "UNECE",
        "United States"
      ]
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "official_identifier": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "regulatory_system": {
      "type": "string",
      "enum": [
        "braking_and_stability",
        "occupant_restraint",
        "lighting_and_light_signalling"
      ]
    },
    "regulated_object": {
      "type": "string",
      "minLength": 1
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_applicability": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirement_topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewed_version": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_format": {
      "type": "string",
      "enum": [
        "pdf",
        "xml",
        "mixed"
      ]
    },
    "source_content_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "special_status_notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_status": {
      "type": "string",
      "const": "verified"
    }
  }
}
